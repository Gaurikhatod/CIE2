@model IEnumerable<CourseEnrollment.Models.Course>
@using CourseEnrollment.Extensions

@{
    ViewData["Title"] = "Courses";
}

<div class="container py-4">
    <div class="p-4 p-md-5 mb-4 rounded-4 text-white"
         style="background: linear-gradient(120deg, #111827, #4338ca);">
        <h1 class="display-5 fw-bold">Learn. Build. Grow.</h1>
        <p class="lead mb-0">
            Discover courses and start learning new skills.
        </p>

        @if (ViewBag.StudentName != null)
        {
            <p class="mt-3 mb-0">
                Welcome back, @ViewBag.StudentName!
            </p>
        }
    </div>

    <div class="d-flex flex-wrap justify-content-between
                align-items-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-1">Available Courses</h2>
            <p class="text-secondary mb-0">
                Choose a course that matches your goals.
            </p>
        </div>

        <a asp-controller="Users"
           asp-action="Index"
           class="btn btn-outline-primary">
            View Users API
        </a>
    </div>

    <div class="row g-4">
        @foreach (var course in Model)
        {
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <span class="badge text-bg-primary mb-3">
                            @course.DiscountPercentage% OFF
                        </span>

                        <h5 class="fw-bold">
                            @course.CourseName
                        </h5>

                        <p class="text-secondary">
                            Duration: @course.Duration
                        </p>

                        <p class="text-secondary mb-1">
                            <del>₹@course.Fees.ToString("N2")</del>
                        </p>

                        <h4 class="fw-bold text-primary">
                            ₹@course.CalculateFinalFees().ToString("N2")
                        </h4>

                        <p class="small text-success">
                            You save ₹@(
                                (course.Fees -
                                 course.CalculateFinalFees()).ToString("N2"))
                        </p>

                        <a asp-action="Details"
                           asp-route-id="@course.CourseId"
                           class="btn btn-outline-primary w-100 mb-2">
                            View Details
                        </a>

                        <a asp-action="Enroll"
                           asp-route-id="@course.CourseId"
                           class="btn btn-primary w-100">
                            Enroll Now
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>